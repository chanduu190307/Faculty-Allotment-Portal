# Faculty Allotment System — Environment Configuration Template
# Copy this file to .env and adjust variables for your local or deployment environment.

# Server Port (default: 5000)
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# SQLite Database Location (defaults to faculty_allotment.db in server directory)
# For local development: ./faculty_allotment.db
# For production: /var/lib/faculty_allotment/production.db
DATABASE_URL=./faculty_allotment.db

# Client CORS Allowed Origin (defaults to Vite dev server port 5173)
CLIENT_ORIGIN=http://localhost:5173

# Optional: Session secret for production authentication cookies/tokens
SESSION_SECRET=change-me-to-a-secure-random-secret-in-production
